### ============================================================
### HR Attrition AI — REST API Test File
### Open in VS Code with the "REST Client" extension installed.
### Click "Send Request" above each block to test endpoints.
### ============================================================

@base = http://127.0.0.1:5000


# ==============================================================
# HEALTH CHECK
# ==============================================================

### Health Check
GET {{base}}/api/health
Content-Type: application/json


# ==============================================================
# SINGLE PREDICTION
# ==============================================================

### Single Employee Prediction
POST {{base}}/api/predict
Content-Type: application/json

{
  "age": 32,
  "gender": "Male",
  "marital_status": "Single",
  "education_level": "Bachelors",
  "department": "Engineering",
  "job_role": "Software Engineer",
  "job_level": 2,
  "monthly_income": 75000,
  "stock_option_level": 1,
  "salary_hike_pct": 10,
  "years_at_company": 3,
  "total_working_years": 6,
  "years_since_promotion": 2,
  "num_prior_companies": 2,
  "work_mode": "Hybrid",
  "commute_minutes": 30,
  "overtime_hours_per_week": 12,
  "business_travel_days_per_year": 15,
  "training_hours": 20,
  "manager_support_score": 6,
  "burnout_score": 7,
  "engagement_score": 4,
  "work_life_balance_score": 5,
  "performance_rating": 3,
  "last_review_score": 6.5,
  "uses_ai_tools_at_work": true,
  "perceived_ai_job_risk": 6
}


### Prediction — Validation Error (age out of range)
POST {{base}}/api/predict
Content-Type: application/json

{
  "age": 200,
  "gender": "Male",
  "department": "Engineering",
  "job_role": "Software Engineer",
  "job_level": 2,
  "monthly_income": 75000,
  "performance_rating": 3
}


