# Copy this file to .env and adjust as needed.

ENV=development

# Local dev default (SQLite, zero setup). For SQL Server, use:
# DATABASE_URL=mssql+pyodbc://sa:YourPass123@localhost:1433/BrainTumorDB?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=sqlite:///./app.db

SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

MAX_UPLOAD_MB=10

# Optional: enables LLM-phrased report summaries via the Anthropic API.
# Leave blank to use the built-in deterministic template (default, no key needed).
ANTHROPIC_API_KEY=
