{
  "manifest_version": 3,
  "name": "Fake Job Detector",
  "version": "1.0",
  "description": "Flags suspicious job listings using an autoencoder.",
  "permissions": [],
  "host_permissions": ["http://localhost:5000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
