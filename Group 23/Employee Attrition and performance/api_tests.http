# ==============================================================
# EMPLOYEES
# ==============================================================

### List All Employees (page 1)
GET {{base}}/api/employees?page=1&per_page=10
Content-Type: application/json


### Search Employees by Department
GET {{base}}/api/employees?department=Engineering&page=1&per_page=5
Content-Type: application/json


### Get Single Employee
GET {{base}}/api/employees/EMP001
Content-Type: application/json


# ==============================================================
# ACTION CENTER (Prediction + HR Document Recommendations)
# ==============================================================

### Action Center for Employee EMP001
POST {{base}}/api/employees/EMP001/action-center
Content-Type: application/json


# ==============================================================
# BUSINESS KPIs
# ==============================================================

### Employee Business KPI
POST {{base}}/api/employees/EMP001/business-kpi
Content-Type: application/json


### Workforce Business KPI (entire company)
GET {{base}}/api/workforce/business-kpi
Content-Type: application/json


# ==============================================================
# DASHBOARD
# ==============================================================

### Dashboard KPIs
GET {{base}}/api/dashboard
Content-Type: application/json


# ==============================================================
# HR KNOWLEDGE SEARCH
# ==============================================================

### BM25 Search
POST {{base}}/api/search
Content-Type: application/json

{
  "query": "employee burnout overtime wellbeing",
  "method": "bm25",
  "top_k": 5
}


### TF-IDF Search
POST {{base}}/api/search
Content-Type: application/json

{
  "query": "performance improvement plan",
  "method": "tfidf",
  "top_k": 5
}


### Language Model Search
POST {{base}}/api/search
Content-Type: application/json

{
  "query": "career progression promotion opportunities",
  "method": "language_model",
  "top_k": 5
}


# ==============================================================
# RISK SIMULATION
# ==============================================================

### Simulate Intervention (reduce burnout, increase engagement)
POST {{base}}/api/simulate
Content-Type: application/json

{
  "employee_id": "EMP001",
  "burnout_score": 3,
  "engagement_score": 8,
  "manager_support_score": 9,
  "overtime_hours_per_week": 5
}


# ==============================================================
# MODEL REGISTRY
# ==============================================================

### List All Models
GET {{base}}/api/models
Content-Type: application/json


### Attrition Model Details
GET {{base}}/api/models/attrition
Content-Type: application/json


### Performance Model Details
GET {{base}}/api/models/performance
Content-Type: application/json


# ==============================================================
# REPORTS & CACHE
# ==============================================================

### Download Full Risk Report CSV (all employees)
GET {{base}}/api/export/risk-report
Content-Type: application/json


### Download High Risk Employees Only
GET {{base}}/api/export/risk-report?risk_filter=high
Content-Type: application/json


### Download Engineering Department Report
GET {{base}}/api/export/risk-report?department=engineering
Content-Type: application/json


### Invalidate Dashboard Cache
POST {{base}}/api/cache/invalidate
Content-Type: application/json


# ==============================================================
# SHAP EXPLANATION
# ==============================================================

### SHAP Explanation for Employee EMP001
POST {{base}}/api/employees/EMP001/explain
Content-Type: application/json
